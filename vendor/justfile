# vendored deepseek-harness 管理（gitignore，git clone，同 desktop 模式）。
# 用法：just -f vendor/justfile <recipe>；根 justfile 的 sync / build-dsh 委托到此。
# [working-directory] 相对本 justfile 所在目录（vendor/）解析。

default:
    just --list

[working-directory(".")]
sync:
    @if [ -d deepseek-harness ]; then rm -rf deepseek-harness; fi
    git clone --depth=1 {{ if env("DEEPSEEK_HARNESS_REPO_BRANCH", "") != "" { "-b " + env("DEEPSEEK_HARNESS_REPO_BRANCH") + " " } else { "" } }}{{ env("DEEPSEEK_HARNESS_REPO") }} ./deepseek-harness

[working-directory("deepseek-harness")]
dep: sync
    nub install

# 构建 vendored deepseek-harness 的 host 面 lib 产物（依赖闭包内的包需 lib/ + lib/types）。
[working-directory("deepseek-harness")]
build:
    nub run build:lib:host
