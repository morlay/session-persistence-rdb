{
  "name": "@morlay/session-persistence-rdb",
  "version": "0.0.1",
  "private": true,
  "description": "RDB durable session persistence backend for the DeepSeek Harness",
  "license": "BSD-3-Clause",
  "files": [
    "src",
    "cordis.patch.yml"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./invariant": "./src/invariant.ts",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.4",
    "@deepseek-ai/dsh-invariants": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-llm": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-scope": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-session": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-session-persistence": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-settings": "^0.0.1-rc.5",
    "@deepseek-ai/schemastery": "^3.18.1-rc.4",
    "drizzle-orm": "^1.0.0-rc.4",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@zephyr/config": "0.0.1",
    "@zephyr/plugins": "0.0.1",
    "@zephyr/presets": "0.0.1",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "resolutions": {
    "@zephyr/config": "link:../zephyr/packages/config",
    "@zephyr/plugins": "link:../zephyr/packages/plugins",
    "@zephyr/presets": "link:../zephyr/packages/presets"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.7.5",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": "26.x"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
